#!/bin/sh
# Draft a commit message with Claude from the staged diff.
#
# Skips: merges, squashes, amends, and any commit that already has a message
# (so `git commit -m "..."` always wins).
# Never blocks a commit: if anything fails you get the normal empty template,
# and the reason is printed to the terminal instead of being swallowed.
#
# Enabled via: git config core.hooksPath .githooks

# $2 is the message source: "message" (-m/-F), "merge", "squash", "commit" (amend).
# Empty means a plain `git commit` — the only case we want to draft for.
[ -n "$2" ] && exit 0

if ! command -v claude >/dev/null 2>&1; then
  echo "prepare-commit-msg: \`claude\` not on PATH — skipping message draft" >&2
  exit 0
fi

[ -z "$(git diff --cached --name-only)" ] && exit 0

# The file list shows every change, including binaries and lockfiles.
stat=$(git diff --cached --stat)

# Full contents only for source files. Assets and lockfiles are listed above but
# their bodies are skipped — a single traced SVG deletion once produced a 1.2 MB
# diff, far past the model's input limit.
body=$(git diff --cached -- . \
  ':(exclude)*.svg' ':(exclude)*.png' ':(exclude)*.jpg' ':(exclude)*.jpeg' \
  ':(exclude)*.webp' ':(exclude)*.gif' ':(exclude)*.ico' \
  ':(exclude)package-lock.json' ':(exclude)*.lock' | head -c 60000)

prompt="Write a Conventional Commits message for this staged diff. First line: type(scope): summary, imperative mood, max 72 chars. Add a short body only if the reason for the change isn't obvious from the diff itself. The diff body may be truncated; use the file list for the full picture. Output only the commit message, no preamble, no backticks."

# stderr goes to its own file: the CLI prints warnings there even on success,
# and they'd otherwise end up as the first line of the commit message.
err=$(mktemp)
if ! msg=$(printf '%s\n\n%s' "$stat" "$body" | claude -p --model haiku "$prompt" 2>"$err"); then
  echo "prepare-commit-msg: couldn't draft a message — $(cat "$err")" >&2
  rm -f "$err"
  exit 0
fi
rm -f "$err"

[ -z "$msg" ] && exit 0

printf '%s\n\n%s\n' "$msg" "$(cat "$1")" > "$1"